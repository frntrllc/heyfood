{
  "schema_version": 1,
  "baseline": {
    "repository": "https://github.com/frntrllc/heyfood",
    "commit": "d68091a9cf6341c2c9120ba9251a6e0dd79a9616",
    "product_version": "0.5.0"
  },
  "status": "phase0_in_progress",
  "global_process_controls": [
    "--json",
    "--raw",
    "--no-color",
    "--no-banner",
    "--verbose",
    "--no-input"
  ],
  "audiences": [
    "agent_safe",
    "human_terminal_only",
    "agent_unsupported"
  ],
  "phase0_decision": "No current product-state mutation is agent_safe. Agent-safe mutation remains outside this program; MCP is the sole planned agent mutation path.",
  "root_default": {
    "audience": "human_terminal_only",
    "operation_class": "interactive",
    "input_transport": "attached_terminal",
    "output_transport": "attached_terminal",
    "network": "conditional_authentication_and_conversation",
    "status": "active"
  },
  "policies": {
    "interactive": {
      "audience": "human_terminal_only",
      "operation_class": "interactive",
      "input_transport": "attached_terminal",
      "output_transport": "attached_terminal",
      "network": "authenticated",
      "retry": "never_blind_retry",
      "product_state": "may_mutate_through_explicit_tui_workflows",
      "phase0_gap": null
    },
    "auth_handoff": {
      "audience": "human_terminal_only",
      "operation_class": "authorization",
      "input_transport": "arguments_plus_independent_browser_or_device_approval",
      "output_transport": "human_or_one_json_result",
      "network": "authorization_server",
      "retry": "protocol_specific_no_blind_retry_after_dispatch",
      "product_state": "rotates_local_and_server_authority",
      "phase0_gap": "Agent setup must not treat browser/device approval as product mutation consent."
    },
    "conversation_review_pending": {
      "audience": "agent_unsupported",
      "operation_class": "remote_conversation",
      "input_transport": "arguments_or_bounded_utf8_stdin",
      "output_transport": "human_or_one_json_result",
      "network": "post_sse",
      "retry": "reconcile_uncertain_never_blind_retry",
      "product_state": "conversation_state_and_server_tools_require_audit",
      "phase0_gap": "Prove that conversational routes cannot directly or indirectly commit a protected mutation before reclassification."
    },
    "human_meal_mutation": {
      "audience": "human_terminal_only",
      "operation_class": "mutation_via_conversation",
      "input_transport": "arguments_or_bounded_utf8_data_stdin_plus_controlling_terminal_decision",
      "output_transport": "human_or_one_json_result",
      "network": "post_sse",
      "retry": "reconcile_uncertain_never_blind_retry",
      "product_state": "meal_memory_mutation",
      "phase0_gap": null
    },
    "grocery_read": {
      "audience": "agent_unsupported",
      "operation_class": "remote_read",
      "input_transport": "arguments",
      "output_transport": "human_or_one_json_result",
      "network": "get",
      "required_scopes": [
        "grocery:read"
      ],
      "retry": "safe_only_before_or_as_defined_by_get_contract",
      "product_state": "no_grocery_product_mutation_but_session_may_rotate",
      "phase0_gap": "Application display-read controller extraction is complete; the bounded agent presentation remains Phase 1 work."
    },
    "grocery_prepare_human": {
      "audience": "human_terminal_only",
      "operation_class": "prepare",
      "input_transport": "arguments_plus_controlling_terminal_acknowledgement",
      "output_transport": "capability_bearing_proposal_json_or_human",
      "network": "post_prepare",
      "required_scopes": [
        "grocery:read",
        "grocery:write"
      ],
      "retry": "dg_r2_no_blind_retry",
      "product_state": "no_list_mutation_but_emits_commit_authority",
      "phase0_gap": null
    },
    "grocery_export_human": {
      "audience": "human_terminal_only",
      "operation_class": "remote_read_and_optional_sensitive_file_write",
      "input_transport": "arguments",
      "output_transport": "stdout_or_owner_only_atomic_file",
      "network": "get",
      "required_scopes": [
        "grocery:read"
      ],
      "retry": "safe_read_with_fail_closed_file_commit",
      "product_state": "no_remote_mutation_local_file_optional",
      "phase0_gap": "Arbitrary output paths are not part of the planned agent-safe surface."
    },
    "grocery_confirm_human": {
      "audience": "human_terminal_only",
      "operation_class": "confirm_or_cancel",
      "input_transport": "proposal_json_stdin_plus_distinct_controlling_terminal_review_and_decision",
      "output_transport": "contracted_json_result",
      "network": "post_mutation",
      "required_scopes": [
        "grocery:read",
        "grocery:write"
      ],
      "retry": "reconcile_uncertain_never_blind_retry",
      "product_state": "grocery_list_mutation_on_accept",
      "phase0_gap": null
    },
    "watch_read": {
      "audience": "agent_unsupported",
      "operation_class": "remote_read",
      "input_transport": "arguments",
      "output_transport": "human_or_one_json_result",
      "network": "get",
      "required_scopes": [
        "menu:watch"
      ],
      "retry": "safe_only_before_or_as_defined_by_get_contract",
      "product_state": "no_menu_watch_product_mutation_but_session_may_rotate",
      "phase0_gap": "Application port/controller extraction is complete; the bounded agent result remains Phase 1 work."
    },
    "watch_mutation_human": {
      "audience": "human_terminal_only",
      "operation_class": "mutation",
      "input_transport": "arguments_plus_controlling_terminal_decision",
      "output_transport": "human_or_one_json_result",
      "network": "post_or_delete",
      "required_scopes": [
        "menu:watch"
      ],
      "retry": "reconcile_uncertain_never_blind_retry",
      "product_state": "menu_watch_subscription_mutation",
      "phase0_gap": null
    },
    "completion": {
      "audience": "agent_unsupported",
      "operation_class": "local_read",
      "input_transport": "arguments",
      "output_transport": "shell_source_stdout",
      "network": "none",
      "retry": "not_applicable",
      "product_state": "none",
      "phase0_gap": "Completion is not a one-JSON-result agent discovery contract."
    },
    "deferred_health": {
      "audience": "agent_unsupported",
      "operation_class": "deferred",
      "input_transport": "rejected_before_credential_access",
      "output_transport": "typed_error",
      "network": "none",
      "retry": "not_applicable",
      "product_state": "none",
      "phase0_gap": null
    },
    "unavailable_legacy": {
      "audience": "agent_unsupported",
      "operation_class": "unavailable",
      "input_transport": "rejected",
      "output_transport": "typed_error",
      "network": "none",
      "retry": "not_applicable",
      "product_state": "none",
      "phase0_gap": null
    }
  },
