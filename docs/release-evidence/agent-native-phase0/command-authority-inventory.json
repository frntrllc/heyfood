    "--no-banner": "disable_decorative_branding",
    "--verbose": "enable_privacy_safe_stderr_diagnostics",
    "--no-input": "reject_missing_or_human_only_input",
    "--help": "local_help_then_exit",
    "--version": "local_version_then_exit"
  },
