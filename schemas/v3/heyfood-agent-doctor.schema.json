{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hey.food/schemas/v3/heyfood-agent-doctor.schema.json",
  "title": "heyfood agent doctor result v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "binary_version",
    "target",
    "manifest_schema_version",
    "manifest_sha256",
    "embedded",
    "checks",
    "network_accessed",
    "credentials_accessed",
    "product_state_mutated",
    "tui_automation_supported"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "ok": { "type": "boolean" },
    "binary_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target": { "type": "string", "minLength": 1, "maxLength": 128 },
    "manifest_schema_version": { "const": 3 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "embedded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guide_sha256",
        "safety_sha256",
        "manifest_schema_sha256",
        "schema_index_schema_sha256",
        "doctor_schema_sha256",
        "guide_schema_sha256",
        "schema_result_schema_sha256",
        "cli_error_schema_sha256",
        "public_output_schema_sha256",
        "proposal_presentation_schema_sha256"
      ],
      "properties": {
        "guide_sha256": { "$ref": "#/$defs/sha256" },
        "safety_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_schema_sha256": { "$ref": "#/$defs/sha256" },
        "schema_index_schema_sha256": { "$ref": "#/$defs/sha256" },
        "doctor_schema_sha256": { "$ref": "#/$defs/sha256" },
        "guide_schema_sha256": { "$ref": "#/$defs/sha256" },
        "schema_result_schema_sha256": { "$ref": "#/$defs/sha256" },
        "cli_error_schema_sha256": { "$ref": "#/$defs/sha256" },
        "public_output_schema_sha256": { "$ref": "#/$defs/sha256" },
        "proposal_presentation_schema_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "status": { "enum": ["pass", "fail"] }
        }
      }
    },
    "network_accessed": { "const": false },
    "credentials_accessed": { "const": false },
    "product_state_mutated": { "const": false },
    "tui_automation_supported": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
