{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hey.food/schemas/v1/heyfood-agent-compatibility.schema.json",
  "title": "heyfood agent compatibility result v1",
  "description": "Version-invariant, offline compatibility diagnosis owned by the installed binary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binary_version",
    "manifest_schema_version",
    "compatible",
    "installations",
    "network_accessed",
    "credentials_accessed",
    "product_state_mutated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "binary_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "manifest_schema_version": { "type": "integer", "minimum": 1 },
    "compatible": { "type": "boolean" },
    "installations": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/installation" }
    },
    "network_accessed": { "const": false },
    "credentials_accessed": { "const": false },
    "product_state_mutated": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "compatible": { "const": true } }, "required": ["compatible"] },
      "then": {
        "properties": {
          "installations": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/compatible_installation" }
          }
        }
      },
      "else": {
        "properties": {
          "installations": {
            "contains": {
              "properties": { "status": { "enum": ["incompatible", "skill_identity_unknown"] } },
              "required": ["status"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "host_version",
        "receipt_state",
        "skill_package_version",
        "skill_sha256",
        "supported_manifest_minimum",
        "supported_manifest_maximum",
        "status",
        "reason",
        "remediation"
      ],
      "properties": {
        "host": { "enum": ["codex", "claude-code"] },
        "host_version": { "type": ["string", "null"], "maxLength": 128 },
        "receipt_state": { "enum": ["verified", "missing", "invalid"] },
        "skill_package_version": { "type": ["string", "null"], "maxLength": 64 },
        "skill_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "supported_manifest_minimum": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "supported_manifest_maximum": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["compatible", "incompatible", "skill_identity_unknown"] },
        "reason": {
          "enum": [
            "supported_manifest_range",
            "manifest_schema_too_new",
            "manifest_schema_too_old",
            "receipt_missing",
            "receipt_invalid"
          ]
        },
        "remediation": { "$ref": "#/$defs/remediation" }
      },
      "allOf": [
        {
          "if": { "properties": { "host": { "const": "codex" } }, "required": ["host"] },
          "then": { "properties": { "remediation": { "$ref": "#/$defs/codex_remediation" } } }
        },
        {
          "if": { "properties": { "host": { "const": "claude-code" } }, "required": ["host"] },
          "then": { "properties": { "remediation": { "$ref": "#/$defs/claude_remediation" } } }
        }
      ]
    },
    "compatible_installation": {
      "allOf": [
        { "$ref": "#/$defs/installation" },
        {
          "properties": {
            "host_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "receipt_state": { "const": "verified" },
            "skill_package_version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "skill_sha256": { "$ref": "#/$defs/sha256" },
            "supported_manifest_minimum": { "type": "integer", "minimum": 1 },
            "supported_manifest_maximum": { "type": "integer", "minimum": 1 },
            "status": { "const": "compatible" },
            "reason": { "const": "supported_manifest_range" }
          }
        }
      ]
    },
    "remediation": {
      "oneOf": [
        { "$ref": "#/$defs/codex_remediation" },
        { "$ref": "#/$defs/claude_remediation" }
      ]
    },
    "codex_remediation": {
      "$ref": "#/$defs/remediation_base",
      "properties": { "arguments": { "$ref": "#/$defs/codex_arguments" } }
    },
    "claude_remediation": {
      "$ref": "#/$defs/remediation_base",
      "properties": { "arguments": { "$ref": "#/$defs/claude_arguments" } }
    },
    "remediation_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "arguments"],
      "properties": {
        "program": { "const": "heyfood" },
        "arguments": { "type": "array" }
      }
    },
    "codex_arguments": {
      "type": "array",
      "prefixItems": [
        { "const": "agent" }, { "const": "setup" }, { "const": "--target" },
        { "const": "codex" }, { "const": "--scope" }, { "const": "user" },
        { "const": "--replace" }, { "const": "--dry-run" }
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    },
    "claude_arguments": {
      "type": "array",
      "prefixItems": [
        { "const": "agent" }, { "const": "setup" }, { "const": "--target" },
        { "const": "claude" }, { "const": "--scope" }, { "const": "user" },
        { "const": "--replace" }, { "const": "--dry-run" }
      ],
      "items": false,
      "minItems": 8,
      "maxItems": 8
    }
  }
}
