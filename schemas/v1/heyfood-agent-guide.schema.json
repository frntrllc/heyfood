{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hey.food/schemas/v1/heyfood-agent-guide.schema.json",
  "title": "heyfood embedded agent guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "media_type",
    "sha256",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "media_type": {
      "const": "text/markdown"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "type": "string",
      "maxLength": 1048576
    }
  }
}
