{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hey.food/schemas/v1/heyfood-agent-setup-plan.schema.json",
  "title": "heyfood Agent Skill setup plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "mode",
    "target",
    "scope",
    "project_root",
    "binary",
    "package",
    "plan_sha256",
    "ready",
    "changed",
    "hosts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "uninstall"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry_run",
        "apply"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "all"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "user",
        "project"
      ]
    },
    "project_root": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "binary": {
      "$ref": "#/$defs/binary"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ready": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/host"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "const": "0.6.3"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256",
        "files"
      ],
      "properties": {
        "name": {
          "const": "heyfood"
        },
        "version": {
          "const": "0.6.3"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "const": 6
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "host_executable",
        "host_version",
        "compatible_version",
        "compatibility",
        "skill_path",
        "receipt_path",
        "mcp",
        "action",
        "conflicts",
        "user_actions"
      ],
      "properties": {
        "host": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ]
        },
        "host_executable": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "host_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "compatible_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "compatibility": {
          "type": "string",
          "enum": [
            "compatible",
            "incompatible",
            "missing"
          ]
        },
        "skill_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "receipt_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mcp": {
          "$ref": "#/$defs/mcp"
        },
        "action": {
          "type": "string",
          "enum": [
            "install",
            "replace",
            "uninstall",
            "none",
            "conflict"
          ]
        },
        "conflicts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "user_actions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "transport",
        "command",
        "arguments",
        "environment",
        "environment_policy_sha256",
        "configuration_scope",
        "action"
      ],
      "properties": {
        "name": {
          "const": "heyfood"
        },
        "transport": {
          "const": "stdio"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "arguments": {
          "const": [
            "mcp",
            "serve"
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        },
        "environment_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_scope": {
          "enum": [
            "user",
            "project",
            "unsupported"
          ]
        },
        "action": {
          "enum": [
            "install",
            "replace",
            "uninstall",
            "none",
            "conflict"
          ]
        }
      }
    }
  }
}
