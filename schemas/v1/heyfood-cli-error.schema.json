{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hey.food/schemas/v1/heyfood-cli-error.schema.json",
  "title": "heyfood stable machine error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "error"
  ],
  "properties": {
    "ok": {
      "const": false
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "outcome_uncertain": {
          "const": true
        }
      }
    }
  }
}
