  "idempotency_cases": [
    {
      "id": "normal_proposal_then_commit",
      "proposal": {
        "method": "POST",
        "path": "/v1/agent-approval/proposals",
        "idempotency_key": "00000000-0000-4000-8000-000000000003"
      },
      "commit": {
        "method": "POST",
        "path": "/v1/agent-approval/approvals/00000000-0000-4000-8000-000000000005/commit",
        "idempotency_key": "00000000-0000-4000-8000-000000000006"
      },
      "expected": "both_accepted_once"
    },
    {
      "id": "same_endpoint_identical_replay",
      "method": "POST",
      "path": "/v1/agent-approval/proposals",
      "idempotency_key": "00000000-0000-4000-8000-000000000003",
      "first_jcs_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "replay_jcs_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "expected": "original_result"
    },
    {
      "id": "same_endpoint_mismatched_replay",
      "method": "POST",
      "path": "/v1/agent-approval/proposals",
      "idempotency_key": "00000000-0000-4000-8000-000000000003",
      "first_jcs_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "replay_jcs_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "expected": "approval_conflict"
    }
  ],
  "negative_cases": [
    {
      "id": "alternate_approval_origin",
      "rule": "approval_url_fixed_origin",
      "value": "https://example.invalid/agent-approval/DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD",
      "expected": "invalid_request"
    },
    {
      "id": "approval_url_query_injection",
      "rule": "approval_url_has_no_query",
      "value": "https://auth.hello.food/agent-approval/DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD?decision=accept",
      "expected": "invalid_request"
    },
    {
      "id": "changed_frozen_presentation",
      "rule": "human_view_equals_created_presentation",
      "expected": "approval_conflict"
    },
    {
      "id": "commit_and_cancel_same_approval",
      "rule": "terminal_states_are_exclusive",
      "expected": "approval_conflict"
    },
    {
      "id": "committed_without_receipt",
      "rule": "observation_receipts_match_status",
      "expected": "invalid_request"
    },
    {
      "id": "model_supplied_commit_decision",
      "rule": "commit_request_rejects_unknown_fields",
      "field": "decision",
      "expected": "invalid_request"
    },
    {
      "id": "binding_token_in_json",
      "rule": "request_bodies_reject_binding_token",
      "field": "session_binding_token",
      "expected": "invalid_request"
    },
    {
      "id": "missing_browser_csrf_header",
      "rule": "browser_decision_headers_are_complete",
      "field": "x_heyfood_csrf_token",
      "expected": "forbidden"
    },
    {
      "id": "cross_session_binding",
      "rule": "binding_is_account_and_session_scoped",
      "expected": "forbidden"
    },
    {
      "id": "conflicting_decision_replay",
      "rule": "decision_nonce_is_single_use",
      "expected": "approval_conflict"
    },
    {
      "id": "same_endpoint_idempotency_mismatch",
      "rule": "same_namespace_different_jcs_conflicts",
      "expected": "approval_conflict"
    },
    {
      "id": "blind_retry_after_uncertain_commit",
      "rule": "uncertain_outcome_requires_observation",
      "expected": "outcome_uncertain"
    }
  ]
}
